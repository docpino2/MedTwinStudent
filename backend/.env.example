APP_NAME="MedTwin Student API"
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://medtwin:medtwin@localhost:5432/medtwin
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_CORS_ORIGIN_REGEX=https://.*\.lovable\.app
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
INIT_DB_ON_STARTUP=false
AUTH_SESSION_HOURS=8
# JSON de cuentas iniciales con email, display_name, role (admin/user) y password_hash Argon2id.
# Nunca almacenar contrasenas sin hash en este archivo.
PILOT_ACCOUNTS_JSON=[]
